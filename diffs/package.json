    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "@babel/core": "7.29.7",
    "@eslint-community/eslint-utils": "4.9.1",
    "which-builtin-type": "1.2.1",
    "fast-glob": "3.3.1",
    "side-channel": "1.1.1",
